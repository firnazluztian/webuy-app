# Copy to apps as needed. Never commit real .env files.
# NEXT_PUBLIC_* and VITE_* are visible in the browser — never put secrets there.

NODE_ENV=development

# Storefront (@webuy/web) — public analytics container (not a secret)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Backoffice (@webuy/bo) — API origin for local/proxy (not a secret)
# VITE_API_BASE_URL=http://localhost:3000
